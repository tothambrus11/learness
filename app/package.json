  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ort.ts",
    "dev": "node dev.ts",
    "prebuild": "node scripts/ort.ts",
    "dev:prod": "node dev.ts --prod",
    "build": "vite build",
    "preview": "vite preview --host",
