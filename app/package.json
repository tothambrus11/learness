{
  "name": "frcog-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/ort.mjs",
    "dev": "node dev.mjs",
    "dev:prod": "node dev.mjs --prod",
    "dev:app-only": "vite dev --host",
    "prebuild": "node scripts/ort.mjs",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run check:types && npm run check:svelte",
    "check:types": "tsc --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test"
  },
  "dependencies": {
    "@lucide/svelte": "^1.41.0",
    "@simplewebauthn/browser": "^14.0.0",
    "idb": "^8.0.3",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "22.20.2",
    "fake-indexeddb": "6.2.5",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "svelte": "^5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "^7.1.7",
    "vitest": "5.0.0",
    "wrangler": "^4.129.0"
  }
}
