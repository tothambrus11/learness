    "@types/node": "^22.20.2",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright-core": "^1.63.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.41.0",
    "@simplewebauthn/browser": "^14.0.0",
