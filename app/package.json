{
  "name": "frcog-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:ui",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test tests/*.test.js",
    "dev:ui": "vite dev --host",
    "dev:api": "wrangler dev --local --port 8787 --config ../wrangler.toml",
    "dev:ui-only": "vite dev --host"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.57.0",
    "vite": "^7.1.7",
    "npm-run-all": "^4.1.5",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "idb": "^8.0.3",
    "ts-fsrs": "^5.4.2"
  }
}
