ue":"after","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Lundi vient après dimanche.","en":"Monday comes after Sunday.","f":"après"},{"fr":"Après nous, le déluge.","en":"After us, the Deluge.","f":"après"},{"fr":"Dimanche vient après samedi.","en":"Sunday comes after Saturday.","f":"après"},{"fr":"Après quoi court-il ?","en":"What is he running after?","f":"après"},{"fr":"Je suis après lui.","en":"I am after him.","f":"après"},{"fr":"Elle est après moi.","en":"She's after me.","f":"après"},{"fr":"Ils sont après toi.","en":"They're after you.","f":"après"},{"fr":"C'est après minuit.","en":"It's after midnight.","f":"après"}]},{"k":"avant|prep","fr":"avant","en":["before"],"answer":"avant","lemma":"avant","pos":"prep","lvl":0,"ipa":"/a.vɑ̃/","kind":"function","sense":"earlier than a moment, or ahead of a place","stage":2,"contrast":["après|prep","depuis|prep"],"cue":"before","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Le devoir avant tout.","en":"Duty should come before anything else.","f":"avant"},{"fr":"Regarde avant de sauter.","en":"Look before you leap.","f":"avant"},{"fr":"Pense avant d'agir !","en":"Think before you act!","f":"avant"},{"fr":"Trouvons Tom avant Mary.","en":"Let's find Tom before Mary does.","f":"avant"},{"fr":"Avant que vous mangiez ?","en":"Before eating?","f":"avant"},{"fr":"Betty pourra venir avant midi.","en":"Betty will be able to come before noon.","f":"avant"},{"fr":"Viens ici avant sept heures.","en":"Come here before seven o'clock.","f":"avant"},{"fr":"Elle est revenue avant 8 heures.","en":"She came back before eight.","f":"avant"}]},{"k":"avec|prep","fr":"avec","en":["with"],"answer":"avec","lemma":"avec","pos":"prep","lvl":0,"ipa":"/a.vɛk/","kind":"function","sense":"together with someone, or using something","stage":2,"contrast":["sans|prep","par|prep"],"cue":"with","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Je parle avec qui ?","en":"Who am I talking with?","f":"avec"},{"fr":"Qui vient avec mo