s"},{"fr":"Ne sois pas idiot.","en":"Don't be a fool.","f":"pas"},{"fr":"Ne sois pas ridicule.","en":"Don't be absurd.","f":"pas"},{"fr":"N'hésite pas. Parle.","en":"Don't hesitate. Speak out.","f":"pas"},{"fr":"Ne dis pas ça.","en":"Don't say that.","f":"pas"}]},{"k":"pendant|prep","fr":"pendant","en":["during","for"],"answer":"pendant","lemma":"pendant","pos":"prep","lvl":0,"ipa":"/pɑ̃.dɑ̃/","kind":"function","sense":"throughout a stretch of time that is over","stage":2,"contrast":["depuis|prep","pour|prep"],"cue":"during","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Nous attendions pendant des heures.","en":"We waited for hours and hours.","f":"pendant"},{"fr":"J'ai lu pendant 1 heure.","en":"I had been reading for an hour.","f":"pendant"},{"fr":"Elle réfléchit pendant quelques minutes.","en":"She thought for a few minutes.","f":"pendant"},{"fr":"J'ai essayé pendant longtemps.","en":"I have tried for a long time.","f":"pendant"},{"fr":"Laissez tremper pendant environ 5 minutes.","en":"Steep for about 5 minutes.","f":"pendant"},{"fr":"J’ai travaillé pendant 20 ans.","en":"I have worked for twenty years.","f":"pendant"},{"fr":"Il crie pendant le discours.","en":"He shouts during the speech!","f":"pendant"},{"fr":"Un incendie éclata pendant cette nuit.","en":"A fire broke out during that night.","f":"pendant"}]},{"k":"plus|adv","fr":"plus","en":["no longer","anymore","no more","any more"],"answer":"plus","lemma":"plus","pos":"adv","lvl":0,"ipa":"/ply/","kind":"function","sense":"the second half of ne … plus: something that was, and has stopped","stage":2,"contrast":["pas|adv","jamais|adv"],"cue":"no longer","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"N'en parlons plus.","en":"Let's not talk about it any more.","f":"plus"},{"fr":"Ne discutons plus, simplement !","en":"Let's just not talk anymore.","f":"plus"},{"fr":"Je ne suis plus inspirée.","en":"I'm not inspired anymore.","f":"plus"},{"fr":"Je ne peux plus attendre.","en":"I can't wait any more.","f":"plus"},{"fr":"On ne dit plus ça.","en":"People don't say that anymore.","f":"plus"},{"fr":"Je ne veux plus mentir.","en":"I don't want to lie anymore.","f":"plus"},{"fr":"Je ne suis plus fatigué.","en":"I am no longer tired.","f":"plus"},{"fr":"Je n'ai plus peur.","en":"I'm not afraid any more.","f":"plus"}]},{"k":"pour|prep","fr":"pour","en":["for","in order to","to"],"answer":"pour","lemma":"pour","pos":"prep","lvl":0,"ipa":"/puʁ/","kind":"function","sense":"for the benefit of someone, or with an aim in view","stage":2,"contrast":["par|prep","avec|prep"],"cue":"for","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Merci pour ton explication.","en":"Thanks for your explanation.","f":"pour"},{"fr":"Je rougis pour toi.","en":"I blush for you.","f":"pour"},{"fr":"Merci pour votre attention.","en":"Thank you for your interest.","f":"pour"},{"fr":"Merci pour l'information.","en":"Thank you for the information.","f":"pour"},{"fr":"Mangeons dehors pour changer.","en":"Let's eat out for a change.","f":"pour"},{"fr":"Pour combien de nuits ?","en":"For how many nights?","f":"pour"},{"fr":"Quelle voie pour Boston ?","en":"What track for Boston?","f":"pour"},{"fr":"Pour qui travailles-tu ?","en":"Who do you work for?","f":"pour"}]},{"k":"sans|prep","fr":"sans","en":["without"],"answer":"sans","lemma":"sans","pos":"prep","lvl":0,"ipa":"/sɑ̃/","kind":"function","sense":"lacking something, or not doing it","stage":2,"contrast":["avec|prep","pour|prep"],"cue":"without","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Sans air, nous mourrions.","en":"We would die without air.","f":"sans"},{"fr":"Cela va sans dire.","en":"That goes without saying.","f":"sans"},{"fr":"Vous continuez sans moi.","en":"You go on without me.","f":"sans"},{"fr":"Il mentit, sans hésiter.","en":"He lied, without hesitation.","f":"sans"},{"fr":"Je mourrais, sans toi.","en":"I'd die without you.","f":"sans"},{"fr":"Il roule sans permis.","en":"He drives without a licence.","f":"sans"},{"fr":"Sans feu ni lieu.","en":"Without hearth or home.","f":"sans"},{"fr":"Il parle sans accent.","en":"He speaks without an accent.","f":"sans"}]},{"k":"sauf|prep","fr":"sauf","en":["except","apart from"],"answer":"sauf","lemma":"sauf","pos":"prep","lvl":0,"ipa":"/sof/","kind":"function","sense":"everything but this one","stage":2,"contrast":["avec|prep","sans|prep"],"cue":"except","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Nous allâmes tous, sauf lui.","en":"All of us, except him, went.","f":"sauf"},{"fr":"Tout passe, sauf aimer Dieu.","en":"All things pass away except to love God.","f":"sauf"},{"fr":"Tous sauf un acceptèrent son plan.","en":"All except one agreed to his plan.","f":"sauf"},{"fr":"Ils sont tous arrivés, sauf John.","en":"Except for John, they all arrived.","f":"sauf"},{"fr":"Tout le monde ira sauf toi.","en":"All will go except you.","f":"sauf"},{"fr":"Personne n'avait faim sauf moi.","en":"Nobody was hungry except me.","f":"sauf"},{"fr":"Entrée interdite sauf pour les personnels.","en":"No admittance except on business.","f":"sauf"},{"fr":"Personne n'est bon, sauf Dieu.","en":"No one is good, except God.","f":"sauf"}]},{"k":"selon|prep","fr":"selon","en":["according to","depending on"],"answer":"selon","lemma":"selon","pos":"prep","lvl":0,"ipa":"/sə.lɔ̃/","kind":"function","sense":"as someone says it is, or as something turns out","stage":2,"contrast":["par|prep","pour|prep"],"cue":"according to","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Selon son opinion, oui.","en":"According to his opinion, yes.","f":"selon"},{"fr":"Selon lui, elle est honnête.","en":"According to him, she is honest.","f":"selon"},{"fr":"Il agit selon mon conseil.","en":"He acts according to my advice.","f":"selon"},{"fr":"Selon Marie, il ne viendra pas.","en":"He's not coming, according to Mary.","f":"selon"},{"fr":"Selon la télévision, il pleuvra demain.","en":"According to the TV, it will rain tomorrow.","f":"selon"},{"fr":"Selon les journaux, il neigera demain.","en":"According to the paper, it will snow tomorrow.","f":"selon"},{"fr":"Les animaux agissent selon leurs instincts.","en":"Animals act according to their instincts.","f":"selon"},{"fr":"Selon Dan, Linda s'était suicidé.","en":"According to Dan, Linda had killed herself.","f":"selon"}]},{"k":"alors|adv","fr":"alors","en":["then","so","at that time"],"answer":"alors","lemma":"alors","pos":"adv","lvl":0,"ipa":"/a.lɔʁ/","kind":"function","sense":"and then, or in that case","stage":3,"contrast":["mais|conj","quand|conj"],"cue":"then","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"J'avais alors 18 ans.","en":"I was eighteen then.","f":"alors"},{"fr":"Alors tu seras heureux.","en":"Then you will be happy.","f":"alors"},{"fr":"Pas maintenant, alors quand ?","en":"Not now, then when?","f":"alors"},{"fr":"Alors n'hésitez pas.","en":"So don't hesitate.","f":"alors"},{"fr":"Il était alors étudiant.","en":"He was a student at that time.","f":"alors"},{"fr":"Alors que suggérez-vous ?","en":"So what are you suggesting?","f":"alors"},{"fr":"Alors, encore quelque chose?","en":"So, something more?","f":"alors"},{"fr":"Alors, c'est entendu.","en":"So, it's understood.","f":"alors"}]},{"k":"bien que|conj","fr":"bien que","en":["although","even though"],"answer":"bien que","lemma":"bien que","pos":"conj","lvl":0,"ipa":"/bjɛ̃ kə/","kind":"function","sense":"even though; the verb after it is in the subjonctif","stage":3,"contrast":["si|conj","mais|conj"],"cue":"although","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Jack semblait en forme, bien que fatigué.","en":"Jack was looking well, although tired.","f":"bien que"},{"fr":"Bien que le soleil donnât, il faisait froid.","en":"Although the sun was out, it was cold.","f":"bien que"},{"fr":"Bien que Marie soit malade, elle va travailler.","en":"Although Mary is sick, she will work.","f":"bien que"},{"fr":"Ils dorment dans des chambres séparées, bien que mariés.","en":"They sleep in separate bedrooms even though they're married.","f":"bien que"},{"fr":"Bien que je fusse épuisé, je continuais à travailler.","en":"Although I was exhausted, I continued to work.","f":"bien que"},{"fr":"Bien que les bateaux fussent chargés, ils naviguèrent relativement rapidement.","en":"Although the ships were heavy, they sailed quite quickly.","f":"bien que"},{"fr":"Bien que malade, il s'est rendu à l'école.","en":"Even though he was ill, he went to school.","f":"bien que"},{"fr":"Personne ne peut changer l'histoire, bien que beaucoup aient essayé.","en":"Nobody can change history, although many have tried.","f":"bien que"}]},{"k":"car|conj","fr":"car","en":["for","because"],"answer":"car","lemma":"car","pos":"conj","lvl":0,"ipa":"/kaʁ/","kind":"function","sense":"the reason for what was just said, added after it; written more than spoken","stage":3,"contrast":["donc|conj","mais|conj"],"cue":"for","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Mangez, car vous avez faim.","en":"Eat, for you are hungry.","f":"car"},{"fr":"Car elle s'est sentie malade.","en":"Because she felt sick.","f":"car"},{"fr":"Pardonnez-moi, car j'ai péché.","en":"Forgive me, for I have sinned.","f":"car"},{"fr":"Je vais bien car je suis vivant.","en":"I'm okay because I'm alive.","f":"car"},{"fr":"Il rit car le film est drôle.","en":"He's laughing because the film is funny.","f":"car"},{"fr":"Ne sors pas, car il fait froid !","en":"Don't go out, because it's cold!","f":"car"},{"fr":"Mon nom est Légion, car nous sommes nombreux.","en":"My name is Legion; for we are many.","f":"car"},{"fr":"Je suis triste, car mon chat est mort.","en":"I am sad because my cat died.","f":"car"}]},{"k":"comme|conj","fr":"comme","en":["like","as","since"],"answer":"comme","lemma":"comme","pos":"conj","lvl":0,"ipa":"/kɔm/","kind":"function","sense":"in the same way as, or in the role of","stage":3,"contrast":["si|conj","quand|conj"],"cue":"like","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"C'était comme ça.","en":"It was like this.","f":"comme"},{"fr":"Il est comme mort.","en":"He is as good as dead.","f":"comme"},{"fr":"Il travaille comme traducteur.","en":"He works as a translator.","f":"comme"},{"fr":"Travaille comme une fourmi.","en":"Work as the ant.","f":"comme"},{"fr":"Tu parles comme Eco.","en":"You're speaking like Eco.","f":"comme"},{"fr":"Elle travaille comme effeuilleuse.","en":"She works as an ecdysiast.","f":"comme"},{"fr":"Tom travaille comme videur.","en":"Tom works as a bouncer.","f":"comme"},{"fr":"Je travaille comme professeur.","en":"I work as a teacher.","f":"comme"}]},{"k":"donc|conj","fr":"donc","en":["so","therefore","then"],"answer":"donc","lemma":"donc","pos":"conj","lvl":0,"ipa":"/dɔ̃k/","kind":"function","sense":"what follows is the consequence of what came before","stage":3,"contrast":["mais|conj","car|conj"],"cue":"so","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Donc il est rentré.","en":"So he went in.","f":"donc"},{"fr":"Donc où vais-je ?","en":"So where do I go?","f":"donc"},{"fr":"C’était donc ça.","en":"So that was it.","f":"donc"},{"fr":"Donc, tu l'aimes ?","en":"So, do you like it?","f":"donc"},{"fr":"C'était donc vrai !","en":"So it was true!","f":"donc"},{"fr":"Cesse donc de pleurer.","en":"Then stop crying.","f":"donc"},{"fr":"Trouvez donc un consensus !","en":"So find a consensus!","f":"donc"},{"fr":"Donc, j'aurai du poulet.","en":"Well then, I'll have chicken.","f":"donc"}]},{"k":"lorsque|conj","fr":"lorsque","en":["when"],"answer":"lorsque","lemma":"lorsque","pos":"conj","lvl":0,"ipa":"/lɔʁsk/","kind":"function","sense":"at the time that — the written cousin of quand","stage":3,"contrast":["si|conj","mais|conj"],"cue":"when","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Lorsque je cours, je transpire.","en":"When I run, I get sweaty.","f":"lorsque"},{"fr":"Je déteste lorsque ça arrive.","en":"I hate when that happens.","f":"lorsque"},{"fr":"Verrouille la porte lorsque tu pars.","en":"Please lock the door when you leave.","f":"lorsque"},{"fr":"Enlevez votre chapeau lorsque vous entrez.","en":"Remove your hat when you go inside.","f":"lorsque"},{"fr":"Nous commencerons lorsque Tom sera là.","en":"We'll start when Tom gets here.","f":"lorsque"},{"fr":"Je sortais juste lorsque le téléphone sonna.","en":"I was going out, when the telephone rang.","f":"lorsque"},{"fr":"J'éprouve une douleur lorsque j'urine.","en":"I have pain when urinating.","f":"lorsque"},{"fr":"Je regardais la télé lorsque Yumi arriva.","en":"I was watching TV when Yumi came.","f":"lorsque"}]},{"k":"mais|conj","fr":"mais","en":["but","yet"],"answer":"mais","lemma":"mais","pos":"conj","lvl":0,"ipa":"/mɛ/","kind":"function","sense":"the clause that follows goes against the one before","stage":3,"contrast":["ou|conj","donc|conj"],"cue":"but","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Mais tu l'aimes !","en":"But you like it!","f":"mais"},{"fr":"Mais où sommes-nous ?","en":"But where are we?","f":"mais"},{"fr":"Mais je m'égare.","en":"But I digress.","f":"mais"},{"fr":"Sois poli mais ferme.","en":"Be polite, but firm.","f":"mais"},{"fr":"Elle mange, mais peu.","en":"She eats but little.","f":"mais"},{"fr":"Continue, mais en finnois.","en":"Go on, but in Finnish.","f":"mais"},{"fr":"Mais c'est incroyable !","en":"But that's incredible!","f":"mais"},{"fr":"Mangez modérément, mais régulièrement.","en":"Eat moderately, but regularly.","f":"mais"}]},{"k":"ni|conj","fr":"ni","en":["nor","neither"],"answer":"ni","lemma":"ni","pos":"conj","lvl":0,"ipa":"/ni/","kind":"function","sense":"not this one either: ni … ni is neither … nor","stage":3,"contrast":["ou|conj","sans|prep"],"cue":"nor","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Ni chair ni poisson.","en":"Neither fish nor fowl.","f":"ni"},{"fr":"Je ne bois ni ne fume.","en":"I neither drink nor smoke.","f":"ni"},{"fr":"Il ne voit ni n'entend.","en":"He can't see nor hear.","f":"ni"},{"fr":"Ni l'un ni l'autre.","en":"Neither.","f":"ni"},{"fr":"Ce n'est ni bon ni mauvais.","en":"It's neither good nor bad.","f":"ni"},{"fr":"Ni vous, ni moi ne nous trompons.","en":"Neither you nor I are mistaken.","f":"ni"},{"fr":"Il ne sait ni lire ni écrire.","en":"He can neither read nor write.","f":"ni"},{"fr":"Elle n'est ni riche, ni connue.","en":"She's neither rich nor famous.","f":"ni"}]},{"k":"ou|conj","fr":"ou","en":["or","either"],"answer":"ou","lemma":"ou","pos":"conj","lvl":0,"ipa":"/u/","kind":"function","sense":"one or the other","stage":3,"contrast":["mais|conj","ni|conj"],"cue":"or","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Fumeur ou non-fumeur ?","en":"Smoking or non smoking?","f":"ou"},{"fr":"Chambre simple ou double ?","en":"Single or double room?","f":"ou"},{"fr":"Mondialise-toi ou crève.","en":"Globalise or die.","f":"ou"},{"fr":"Crois-le ou pas.","en":"Believe it or not.","f":"ou"},{"fr":"Arrêtez ou je tire.","en":"Stop or I'll shoot.","f":"ou"},{"fr":"Vivre libre ou mourir.","en":"Live free or die.","f":"ou"},{"fr":"Dieu ou la nature.","en":"God or nature.","f":"ou"},{"fr":"Avec ou sans sucre ?","en":"With or without sugar?","f":"ou"}]},{"k":"parce que|conj","fr":"parce que","en":["because"],"answer":"parce que","lemma":"parce que","pos":"conj","lvl":0,"ipa":"/paʁs kə/","kind":"function","sense":"the reason, answering why","stage":3,"contrast":["mais|conj","quand|conj"],"cue":"because","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Parce que cela existe.","en":"Because it exists.","f":"parce que"},{"fr":"Parce que c'est là.","en":"Because it is there.","f":"parce que"},{"fr":"Parce que je parle chinois.","en":"Because I speak Chinese.","f":"parce que"},{"fr":"Parce que vous le vendez.","en":"Because you sell it.","f":"parce que"},{"fr":"Parce que nous le valons bien.","en":"Because we're worth it.","f":"parce que"},{"fr":"Je mange parce que j'ai faim.","en":"I eat because I'm hungry.","f":"parce que"},{"fr":"Tout est parfait, parce que tu existes.","en":"Everything is perfect because you exist.","f":"parce que"},{"fr":"Parce que personne ne peut parler ma langue.","en":"Because no man can speak my language.","f":"parce que"}]},{"k":"pourtant|adv","fr":"pourtant","en":["yet","however","and yet"],"answer":"pourtant","lemma":"pourtant","pos":"adv","lvl":0,"ipa":"/puʁ.tɑ̃/","kind":"function","sense":"even so: what follows is a surprise after what came before","stage":3,"contrast":["mais|conj","donc|conj"],"cue":"yet","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Et pourtant, elle bouge !","en":"And yet it moves!","f":"pourtant"},{"fr":"Pourtant, abandonner n'est pas impossible.","en":"Yet giving up is not impossible.","f":"pourtant"},{"fr":"Le soleil brillait, pourtant il faisait froid.","en":"The sun was shining, yet it was cold.","f":"pourtant"},{"fr":"Et pourtant, le contraire aussi est toujours vrai.","en":"And yet, the contrary is always true as well.","f":"pourtant"},{"fr":"Pourtant, la chanteuse ne renie pas ses origines.","en":"However, the singer does not deny her ancestry.","f":"pourtant"},{"fr":"Nous sommes pourtant souvent retournés les mains vides.","en":"We often came back, however, empty-handed.","f":"pourtant"},{"fr":"C'est très important. Pourtant, personne n'en parle.","en":"This is very important. Yet no one talks about it.","f":"pourtant"},{"fr":"Pourtant, c'est une traduction directe de la version japonaise.","en":"However, it is a direct translation of the Japanese version.","f":"pourtant"}]},{"k":"puisque|conj","fr":"puisque","en":["since","as","given that"],"answer":"puisque","lemma":"puisque","pos":"conj","lvl":0,"ipa":"/pɥisk/","kind":"function","sense":"a reason both people already know","stage":3,"contrast":["si|conj","mais|conj"],"cue":"since","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Puisque tu le dis.","en":"Since you say so.","f":"puisque"},{"fr":"Puisque je suis ici, laisse-moi t'aider.","en":"Since I'm here, let me help you.","f":"puisque"},{"fr":"Tu devrais arrêter de fumer, puisque c'est malsain.","en":"You must give up smoking, as it is unhealthy.","f":"puisque"},{"fr":"Il doit être chez lui puisque la lumière est allumée.","en":"He must be at home as the light is on.","f":"puisque"},{"fr":"C'est mon tonton, puisque mon papa est son frère.","en":"He's my uncle, since my dad is his brother.","f":"puisque"},{"fr":"Je parle en connaissance de cause puisque j’y étais.","en":"I know what I'm talking about, since I was there.","f":"puisque"},{"fr":"Vous devez être triste puisque vous avez perdu un de vos amis.","en":"You must be sad since you lost one of your friends.","f":"puisque"},{"fr":"Puisque nous avons conduit jusqu'ici, nous ferions aussi bien de continuer.","en":"As long as we've driven this far, we might as well go on.","f":"puisque"}]},{"k":"quand|conj","fr":"quand","en":["when","whenever"],"answer":"quand","lemma":"quand","pos":"conj","lvl":0,"ipa":"/kɑ̃/","kind":"function","sense":"at the time that something happens","stage":3,"contrast":["si|conj","mais|conj"],"cue":"when","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Quand seras-tu libre ?","en":"When will you be free?","f":"quand"},{"fr":"Quand êtes-vous né ?","en":"When were you born?","f":"quand"},{"fr":"Dis-moi quand commencer.","en":"Tell me when to start.","f":"quand"},{"fr":"Quand vas-tu partir ?","en":"When are you going to leave?","f":"quand"},{"fr":"Viens quand tu veux.","en":"Come whenever you like.","f":"quand"},{"fr":"Venez quand vous voulez.","en":"Please come whenever you like.","f":"quand"},{"fr":"Quand es-tu arrivé ?","en":"When did you arrive?","f":"quand"},{"fr":"Quand y arriverons-nous ?","en":"When will we get there?","f":"quand"}]},{"k":"si|conj","fr":"si","en":["if","whether"],"answer":"si","lemma":"si","pos":"conj","lvl":0,"ipa":"/si/","kind":"function","sense":"on the condition that; what follows may or may not happen","stage":3,"contrast":["quand|conj","mais|conj"],"cue":"if","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Ce weekend, si possible.","en":"This weekend, if possible.","f":"si"},{"fr":"Putain si je savais.","en":"Damned if I know.","f":"si"},{"fr":"Si seulement je savais !","en":"If only I knew!","f":"si"},{"fr":"Je viendrai si nécessaire.","en":"I'll come if necessary.","f":"si"},{"fr":"Viens si tu peux !","en":"Come if you can.","f":"si"},{"fr":"Voyons si ça fonctionne !","en":"Let's see if that works.","f":"si"},{"fr":"Si pas maintenant, quand ?","en":"If not now, when?","f":"si"},{"fr":"Voyons si ceci aide.","en":"Let's see if this helps.","f":"si"}]},{"k":"tandis que|conj","fr":"tandis que","en":["whereas","while"],"answer":"tandis que","lemma":"tandis que","pos":"conj","lvl":0,"ipa":"/tɑ̃.di kə/","kind":"function","sense":"at the same time as, and usually in contrast with","stage":3,"contrast":["si|conj","mais|conj"],"cue":"whereas","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Le chameau défile tandis que les chiens aboient.","en":"The camel marches while the dogs bark.","f":"tandis que"},{"fr":"Il est venu tandis que je dormais encore.","en":"He came while I was still asleep.","f":"tandis que"},{"fr":"L'eau gargouille tandis que le feu crépite.","en":"Water gurgles while fire crackles.","f":"tandis que"},{"fr":"Je balayerai le sol tandis que tu fais la vaisselle.","en":"I'll sweep the floor while you wash the dishes.","f":"tandis que"},{"fr":"Je suis pauvre, tandis que mes frères sont très riches.","en":"I am poor, whereas my brothers are very rich.","f":"tandis que"},{"fr":"Dan a brutalement frappé Linda tandis que leur fils regardait.","en":"Dan savagely beat Linda while their son looked on.","f":"tandis que"},{"fr":"J'ai rencontré Bob et Marie tandis que j'attendais Kate.","en":"I met Bob and Mary while I was waiting for Kate.","f":"tandis que"},{"fr":"Un des pôles est négatif, tandis que l'autre est positif.","en":"One of the poles is negative, while the other is positive.","f":"tandis que"}]},{"k":"assez|adv","fr":"assez","en":["enough","quite","fairly"],"answer":"assez","lemma":"assez","pos":"adv","lvl":0,"ipa":"/a.se/","kind":"function","sense":"as much as is needed, or fairly","stage":4,"contrast":["très|adv","trop|adv"],"cue":"enough","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"C'est assez raisonnable.","en":"That's fairly reasonable.","f":"assez"},{"fr":"C'est assez grand ?","en":"Is it large enough?","f":"assez"},{"fr":"George est assez bavard.","en":"George is quite talkative.","f":"assez"},{"fr":"Assez pour aujourd'hui.","en":"That's enough for today.","f":"assez"},{"fr":"Il semble assez content.","en":"He seems quite happy.","f":"assez"},{"fr":"Il est assez sauvage.","en":"He is quite a savage.","f":"assez"},{"fr":"Elle est assez fâchée.","en":"She is quite angry.","f":"assez"},{"fr":"Elle était assez gentille.","en":"She was kind enough.","f":"assez"}]},{"k":"déjà|adv","fr":"déjà","en":["already"],"answer":"déjà","lemma":"déjà","pos":"adv","lvl":0,"ipa":"/de.ʒa/","kind":"function","sense":"sooner than expected, or before now","stage":4,"contrast":["encore|adv","jamais|adv"],"cue":"already","audio":null,"native":null,"cue_audio":null,"ex":[{"fr":"Il est déjà 11 heures.","en":"It is already eleven.","f":"déjà"},{"fr":"J'ai déjà dîné.","en":"I've already had my supper.","f":"déjà"},{"fr":"Il est déjà minuit.","en":"It's midnight already.","f":"déjà"},{"fr":"Il fait déjà sombre.","en":"It is already dark.","f":"déjà"},{"fr":"Mary a déjà commencé.","en":"Mary has already started.","f":"déjà"},{"fr":"C'est déjà démodé.","en":"It's already out of fashion.","f":"déjà"},{"fr":"Je suis déjà prêt.","en":"I am already prepared.","f":"déjà"},{"fr":"Il est déjà sorti.","en":"He has already gone out.","f":"déjà"}]},{"k":"encore|adv","fr":"encore","en":["still","again","more","yet"],"answer":"encore","lemma":"encore","pos":"adv","lvl":0,"ipa":"/ɑ̃.kɔʁ/","kind":"function","sense":"going on, or one more time","stage":4,"contrast":["déjà|adv","jamais|adv"],"cue":"still","audio":null,"native":null,"cue_a